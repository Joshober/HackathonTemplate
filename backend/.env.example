# Copy to .env and fill in values. Do not commit .env.
# Paths: load from repo root use `backend/.env`, or run Flask from `backend/` with `.env` here.

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me
PORT=5001

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB_NAME=hackathon_db

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Admin API (must match frontend ADMIN_SECRET if used) ---
ADMIN_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BACKEND_URL=http://localhost:5001

# --- AI / media ---
OPENROUTER_API_KEY=
# Defaults use Google Gemini via OpenRouter (override with any OpenRouter model id):
# OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# OPENROUTER_CHAT_VISION_MODEL=google/gemini-2.5-flash
# OPENROUTER_VIDEO_MODEL=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
MAGICHOUR_API_KEY=

# --- SMTP (support / notifications) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Web search (chat + travel copilot): DuckDuckGo via ddgs (default, no API key) ---
# /api/chat/copilot calls search_web -> ddgs. Set WEB_SEARCH_PROVIDER=serpapi only if you want Google organic via SerpAPI instead.
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_BOTH=true
SERPAPI_API_KEY=

# --- Travel: flights (Amadeus or Duffel) ---
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOST=test.api.amadeus.com
DUFFEL_ACCESS_TOKEN=
# TRAVEL_FLIGHT_PROVIDER=auto

# --- Travel: SerpAPI scrape in pricing (google_flights + duckduckgo engines) ---
# Requires SERPAPI_API_KEY. Enable scrape, then SerpAPI engines for demo options:
TRAVEL_SCRAPE_OPTIONS=1
TRAVEL_SERPAPI_SCRAPE=1
# TRAVEL_SERPAPI_CURRENCY=USD
# TRAVEL_SERPAPI_GL=us
# TRAVEL_SERPAPI_HL=en
# TRAVEL_SERPAPI_DEEP_SEARCH=false

# --- Explorer / tickets ---
TICKETMASTER_API_KEY=

# --- Demo mode (support flows) ---
DEMO_MODE=false
DEMO_EMAIL_RECIPIENTS=

# --- Google OAuth (calendar integration backend callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/integrations/google/callback

# Optional: other Google keys for frontend/features (names vary by setup)
# GOOGLE_CALENDAR_API_KEY=
# GOOGLE_CLOUD_MAPS_API_KEY=

# --- Local / optional ---
# OLLAMA_BASE_URL=http://localhost:11434
# LIBRARY_SENSOR_URL=
